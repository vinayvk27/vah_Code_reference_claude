        raise HTTPException(403, f"You do not have access to module '{module_name}'.")

elif raw.endswith("_ANALYTICS"):
    module_name = raw
    # Analytics path checks COLLECTION access directly — not module access
    if not AuthController.check_collection_access(
        current_user.emp_no, current_user.group_idx, current_user.role_ids, module_name, db
    ):
        raise HTTPException(403, f"You do not have access to '{module_name}'.")

else:
