if not raw or raw == "GLOBAL":
    resolved_mod, _ = resolve_module_from_request(
        module_name=None, message=request.message, chat_history=request.chat_history,
    )
    module_name = resolved_mod or "RMS"

    # GLOBAL path resolves to a real module (RMS/HRMS/MRR) — check module access as before
